{
  "name": "plan-it-today",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter mini-app dev",
    "build": "pnpm --filter mini-app build",
    "preview": "pnpm --filter mini-app preview",
    "test": "pnpm -r test",
    "assets": "python3 scripts/prepare-assets.py",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "pnpm --filter mini-app test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "type": "module"
}
